<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net*-windows + UseWPF so System.Windows.Point (WindowsBase) is available to the compiler sources -->
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile the geometry engine straight into the test assembly (no dependency on the WPF app) -->
    <Compile Include="..\CompanionApp\Draw\Services\DrawCompiler.cs" Link="Engine\DrawCompiler.cs" />
    <Compile Include="..\CompanionApp\Draw\Services\DrawText.cs" Link="Engine\DrawText.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

</Project>
