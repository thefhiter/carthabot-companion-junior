<UserControl x:Class="CompanionApp.Controls.MiniBot3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Viewport3D x:Name="Vp" ClipToBounds="True">
        <Viewport3D.Camera>
            <PerspectiveCamera Position="3.6,5.8,3.9" LookDirection="-3.6,-5.8,-3.35" UpDirection="0,0,1" FieldOfView="42" />
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#5A5A5A" />
                    <DirectionalLight x:Name="KeyLight" Color="#FFFFFF" Direction="-0.5,-1,-1.5" />
                    <DirectionalLight Color="#3A3A3A" Direction="1,1,-0.4" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="Halo" />
        <ModelVisual3D x:Name="RobotHost" />
    </Viewport3D>
</UserControl>
