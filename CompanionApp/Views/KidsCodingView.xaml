<UserControl x:Class="CompanionApp.Views.KidsCodingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:iconpack="http://metro.mahapps.com/winfx/xaml/iconpacks"
             FontFamily="Segoe UI Symbol">

    <UserControl.Resources>
        <!-- A single big programming block (used in both the palette and the program strip) -->
        <Style x:Key="BlockBorder" TargetType="Border">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Height" Value="96"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="#192428">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- header -->
                <RowDefinition Height="Auto"/>
                <!-- program strip -->
                <RowDefinition Height="*"/>
                <!-- palette -->
                <RowDefinition Height="Auto"/>
                <!-- controls -->
            </Grid.RowDefinitions>

            <!-- ===================== HEADER ===================== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconpack:PackIconFontAwesome Kind="ChildSolid" Width="34" Height="34" Foreground="#2bc0e8" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource kidsTitle}" Foreground="White" FontWeight="Bold" FontSize="30" Margin="14 0 0 0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- connection status pill -->
                <Border Grid.Column="1" CornerRadius="14" Padding="14 7" VerticalAlignment="Center" Margin="0 0 12 0"
                        Background="{Binding StatusColor}">
                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="DemiBold" FontSize="15" VerticalAlignment="Center"/>
                </Border>

                <!-- back / home -->
                <Border Grid.Column="2" Width="48" Height="48" CornerRadius="24" Background="#2d383c" Cursor="Hand" VerticalAlignment="Center">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding CloseCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <iconpack:PackIconFontAwesome Kind="HouseSolid" Width="22" Height="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- ===================== PROGRAM STRIP ===================== -->
            <Border Grid.Row="1" Margin="0 18 0 0" CornerRadius="16" Background="#22313a" BorderBrush="#33454f" BorderThickness="2" MinHeight="140">
                <Grid Margin="16 12">
                    <!-- empty hint -->
                    <TextBlock Text="{DynamicResource kidsHint}" Foreground="#7c8b92" FontSize="18" FontWeight="DemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBlocks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Program}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource BlockBorder}" Background="{Binding Color}"
                                                ToolTip="{DynamicResource kidsRemoveTip}">
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.RemoveBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontSize="44" Foreground="White" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="DemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ===================== PALETTE ===================== -->
            <Border Grid.Row="2" Margin="0 16 0 0" CornerRadius="16" Background="#2d383c" BorderBrush="#33454f" BorderThickness="2">
                <StackPanel Margin="16 14">
                    <TextBlock Text="{DynamicResource kidsBlocks}" Foreground="#9fb0b7" FontSize="16" FontWeight="DemiBold" Margin="6 0 0 8"/>
                    <ItemsControl ItemsSource="{Binding Palette}" HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BlockBorder}" Background="{Binding Color}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                            <i:InvokeCommandAction Command="{Binding DataContext.AddBlockCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   CommandParameter="{Binding}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Glyph}" FontSize="46" Foreground="White" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Caption}" FontSize="13" FontWeight="DemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===================== CONTROLS ===================== -->
            <Grid Grid.Row="3" Margin="0 18 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- repeat stepper -->
                <Border Grid.Column="0" CornerRadius="14" Background="#2d383c" Padding="10 6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconpack:PackIconFontAwesome Kind="ArrowRotateRightSolid" Width="20" Height="20" Foreground="#9fb0b7" VerticalAlignment="Center" Margin="2 0 10 0"/>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#3c4a50" Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding RepeatMinusCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TextBlock Text="−" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Repeat}" Foreground="White" FontSize="24" FontWeight="Bold" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Border Width="34" Height="34" CornerRadius="17" Background="#3c4a50" Cursor="Hand">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding RepeatPlusCommand}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <TextBlock Text="+" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{DynamicResource kidsTimes}" Foreground="#9fb0b7" FontSize="14" FontWeight="DemiBold" VerticalAlignment="Center" Margin="10 0 4 0"/>
                    </StackPanel>
                </Border>

                <!-- PLAY -->
                <Border Grid.Column="2" CornerRadius="16" Background="#37D67A" Padding="34 14" Margin="0 0 12 0" Cursor="Hand" VerticalAlignment="Center">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding PlayCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconpack:PackIconFontAwesome Kind="PlaySolid" Width="22" Height="22" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource kidsPlay}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="12 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- CLEAR -->
                <Border Grid.Column="3" CornerRadius="16" Background="#3c4a50" Padding="22 14" Cursor="Hand" VerticalAlignment="Center">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding ClearCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconpack:PackIconFontAwesome Kind="TrashCanSolid" Width="20" Height="20" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource kidsClear}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="10 0 0 0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
