<UserControl x:Class="CompanionApp.Views.AssamblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:syncfusion="clr-namespace:Syncfusion.Windows.PdfViewer;assembly=Syncfusion.PdfViewer.WPF"
             xmlns:iconpack="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:controls="clr-namespace:CompanionApp.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Border BorderBrush="#FFFFFFFF" Background="#192428" Margin="10 5 10 5"  Grid.Column="1"   BorderThickness="1"  CornerRadius="5">

        <Grid >

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Button Command="{Binding CloseViewCommand}" Cursor="Hand" Margin="20 5"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Width="35" Height="35"
                                    Background="Transparent" BorderThickness="2" BorderBrush="White">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <iconpack:PackIconCoolicons Kind="House01" Foreground="White"
                                                     Height="15" Width="15"/>
            </Button>

            <!-- 3D / 2D toggle: swaps the SVG manual for an interactive exploded view -->
            <Button x:Name="Toggle3DBtn" Click="OnToggle3D" Cursor="Hand" Margin="0 5 65 5"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Height="35" MinWidth="50" Padding="10 0"
                    Background="Transparent" BorderThickness="2" BorderBrush="#EE7B2F">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="Toggle3DText" Text="3D" Foreground="#EE7B2F" FontWeight="Bold" FontSize="14"/>
            </Button>


            <Border  x:Name="LoadingBorder" Visibility="Visible" Margin="5" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                <!-- You can add a spinner or "Loading..." text here -->
                <TextBlock Text="Loading..." HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
            </Border>


            <ScrollViewer x:Name="ManualHost" Grid.Row="1" Margin="5" Background="White" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                <wv2:WebView2

                  Source="{Binding source}" />
            </ScrollViewer>

            <!-- Interactive 3D exploded view (hidden until the 3D toggle is pressed) -->
            <Grid x:Name="Exploded3DHost" Grid.Row="1" Margin="5" Background="#192428" Visibility="Collapsed">
                <controls:Model3DViewer x:Name="Exploded3D" />
                <TextBlock Text="Drag to orbit  ·  scroll to zoom  ·  right-drag to pan"
                           Foreground="#80FFFFFF" FontSize="12" HorizontalAlignment="Center"
                           VerticalAlignment="Bottom" Margin="0 0 0 10" IsHitTestVisible="False"/>
            </Grid>


        </Grid>

    </Border>

</UserControl>
