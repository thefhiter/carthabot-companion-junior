<UserControl x:Class="CompanionApp.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:controls="clr-namespace:DMSkin.WPF.Controls;assembly=DMSkin.WPF"
             xmlns:iconpack="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
                prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <!-- Hover/scale style -->
        <Style TargetType="Grid" x:Key="HoverScaleStyle">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.2" Duration="0:0:0.3" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.2" Duration="0:0:0.3" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2" />
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="CollapseHeightStoryboard">
            <DoubleAnimation Storyboard.TargetName="SlidingGridScaleTransform" 
                             Storyboard.TargetProperty="ScaleY" 
                             To="0" Duration="0:0:1" />
        </Storyboard>

        <!-- Expand animation -->
        <Storyboard x:Key="ExpandHeightStoryboard">
            <DoubleAnimation Storyboard.TargetName="SlidingGridScaleTransform" 
                             Storyboard.TargetProperty="ScaleY" 
                             To="1" Duration="0:0:0.3" />
        </Storyboard>
        
        <!-- Step DataTemplate -->
        <DataTemplate x:Key="StepTemplate">
            <Grid Style="{StaticResource HoverScaleStyle}">
                <TextBlock FontSize="20"
                       FontWeight="DemiBold"
                       Text="{Binding Title}" />
            </Grid>
        </DataTemplate>

        <!-- ViewModel -->
    </UserControl.Resources>

    <Grid >

        <Border Background="#192428" Grid.Row="1">
            <Grid  Margin="2.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="0.2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Border  Grid.Row="0"  Margin="2.5" Grid.Column="1"
                    Cursor="Hand" BorderBrush="Gray" Background="#2d383c"
                    BorderThickness="2" CornerRadius="10"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenAssamblyCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>


                    <Grid  Style="{StaticResource HoverScaleStyle}" Background="Transparent" VerticalAlignment="Center">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Vertical">
                            <Image Source="../Resources/technical-drawing.png"
                              Width="100" Height="100"
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Center"/>

                            <TextBlock Text="{DynamicResource techincalDoc}" 
                               Grid.Row="1"
                               Foreground="#FFFFFFFF" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0 5"
                               HorizontalAlignment="Center"
                               FontWeight="DemiBold"
                               FontSize="20"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="2.5" Grid.Column="1"
                    Cursor="Hand" BorderBrush="Gray" Background="#2d383c"
                    BorderThickness="2" CornerRadius="10"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenWebSiteCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <Grid Style="{StaticResource HoverScaleStyle}"  Background="Transparent" VerticalAlignment="Center">

                        <StackPanel Orientation="Vertical">
                            <iconpack:PackIconFontAwesome Kind="GlobeSolid"
                          Width="100" Height="100"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{DynamicResource siteOur}" 
                           Grid.Row="1"
                           Foreground="#FFFFFFFF"
                           Margin="0 5"
                           HorizontalAlignment="Center"
                           FontWeight="DemiBold"
                           FontSize="20"/>
                        </StackPanel>
                        
                    </Grid>
                </Border>

                <Border Grid.Row="3" Margin="2.5" Grid.Column="1"
                    Cursor="Hand" BorderBrush="Gray" Background="#2d383c"
                    BorderThickness="2" CornerRadius="10"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenWebGithubCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <Grid Style="{StaticResource HoverScaleStyle}"  Background="Transparent" VerticalAlignment="Center">


                        <StackPanel Orientation="Vertical">
                            <iconpack:PackIconEvaIcons Kind="Github"
                                      Width="100" Height="100"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"/>

                            <TextBlock Text="{DynamicResource githubOur}" 
                           Grid.Row="1"
                           Foreground="#FFFFFFFF"
                           Margin="0 5"
                           HorizontalAlignment="Center"
                           FontWeight="DemiBold"
                           FontSize="20"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="2.5" Grid.Column="1"
                        Cursor="Hand" BorderBrush="Gray" Background="#2d383c"
                        BorderThickness="2" CornerRadius="10"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding OpenWebCarthaSoftCommand}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <Grid Style="{StaticResource HoverScaleStyle}"  Background="Transparent" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Vertical">
                            <Image Source="../Resources/CarthaSoftLogo.png"
                              Width="110" Height="110"
                              VerticalAlignment="Center" 
                              HorizontalAlignment="Center"/>

                            <TextBlock Text="CarthaSoft" 
                               Grid.Row="1"
                               Foreground="#FFFFFFFF"
                               Margin="0"
                               HorizontalAlignment="Center"
                               FontWeight="DemiBold"
                               FontSize="20"/>
                        </StackPanel>

                    </Grid>
                </Border>
                
                <Border Grid.Row="0" Grid.RowSpan="4" Margin="2.5" Grid.Column="0" BorderBrush="Gray"  Background="#2d383c" BorderThickness="2" CornerRadius="10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{DynamicResource modules}" Foreground="#FFFFFFFF" Margin="10 5" HorizontalAlignment="Left" FontWeight="DemiBold" FontSize="40"/>
                        <ContentControl Grid.Column="1" x:Name="AtelierRegion" prism:RegionManager.RegionName="AtelierRegion" VerticalAlignment="Stretch"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>




        <!-- SlidingGrid -->
        <Grid VerticalAlignment="Stretch" Background="#192428"  x:Name="SlidingGrid" Visibility="{Binding IsViewVisiblity}" Grid.ColumnSpan="2"
              RenderTransformOrigin="0.5,1">
            <!-- Origin is set to bottom-center -->
            <Grid.RenderTransform>
                <ScaleTransform x:Name="SlidingGridScaleTransform" ScaleY="0" />
            </Grid.RenderTransform>
            <ContentControl Content="{Binding View}" />

        </Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPlugInAnimation}" Value="true">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowPlugInAnimation}" Value="false">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="LightGray" Opacity="0.4"/>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="0 20" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>

                    </Grid.RowDefinitions>

                    <Border Margin="20" CornerRadius="10">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>


                            <Border Background="White" Margin="5" BorderBrush="#0060ac" BorderThickness="3" CornerRadius="10">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="5">

                                    <Border Background="#0060ac" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1">
                                        <TextBlock Text="{DynamicResource step1Title}" FontSize="18" Padding="10 5" FontWeight="Bold"/>
                                    </Border>
                                    <Border VerticalAlignment="Top">
                                        <Image Source="/Resources/STEP 1.png">
                                        </Image>
                                    </Border>



                                    <Border Margin="0 5" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="0">
                                        <TextBlock Foreground="Black"  TextWrapping="Wrap" 
                                               Text="{DynamicResource step1Desc}"
                                               FontSize="18" FontWeight="DemiBold"/>
                                    </Border>
                                </StackPanel>

                            </Border>
                            <Border Grid.Column="1" Margin="5" Background="White" BorderBrush="#0060ac" BorderThickness="3" CornerRadius="10">
                                <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="5">


                                    <Border Background="#0060ac" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1">
                                        <TextBlock Text="{DynamicResource step2Title}" FontSize="18" Padding="10 5" FontWeight="Bold"/>
                                    </Border>
                                    <Border VerticalAlignment="Top">
                                        <Image Source="/Resources/STEP 2.png">
                                        </Image>
                                    </Border>
                                    <Border Margin="0 5" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="0">
                                        <TextBlock Foreground="Black" TextWrapping="Wrap" 
                                               Text="{DynamicResource step2Desc}"
                                               FontSize="18" FontWeight="DemiBold"/>
                                    </Border>


                                </StackPanel>

                            </Border>
                            <Border Grid.Column="2" Margin="5" Background="White" BorderBrush="#0060ac" BorderThickness="3" CornerRadius="10">
                                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="5" VerticalAlignment="Top">

                                    <Border Background="#0060ac" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1">
                                        <TextBlock Text="{DynamicResource step3Title}" FontSize="18" Padding="10 5" FontWeight="Bold"/>
                                    </Border>
                                    
                                    <Border VerticalAlignment="Top">
                                        <Image Source="/Resources/STEP 3.png">

                                        </Image>
                                    </Border>


                                    <Border Margin="0 5" BorderBrush="Gray"
                                        CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        BorderThickness="0">
                                        <TextBlock Foreground="Black" TextWrapping="Wrap" 
                                               Text="{DynamicResource step3Desc}"
                                               FontSize="18" FontWeight="DemiBold"/>
                                    </Border>


                                </StackPanel>

                            </Border>
                        </Grid>
                        

                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <syncfusion:SfStepProgressBar 
                            Grid.Column="1"
                            ItemSpacing="200"
                            ItemsSource="{Binding Steps}"
                            SelectedIndex="{Binding SelectedIndex}"
                            SelectedItemStatus="{Binding SelectedItemStatus}"
                            MarkerShapeType="{Binding SelectedMarkerShape}"                                
                            Orientation="Horizontal"
                            ItemTemplate="{StaticResource StepTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Grid>



                    <TextBlock Margin="5" FontWeight="DemiBold" TextWrapping="Wrap" Visibility="Hidden" FontSize="17"
                               Grid.Row="2" Text="{DynamicResource bootMode}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <controls:DMButton Cursor="Hand" Command="{Binding CancelCommand}" Grid.Row="3" Background="#2d383c"  FontWeight="DemiBold" Foreground="White" FontSize="18" Padding="5" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" Margin="5">
                        Cancel
                    </controls:DMButton>
                </Grid>

            </Grid>

        </Grid>

        <!-- ============ CONNECTION CHOOSER (shown BEFORE the USB flash wizard) ============ -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowConnectionChooser}" Value="true">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.Resources>
                <!-- card: hover lift + soft shadow (RenderTransform/Effect are set per-card so they aren't shared) -->
                <Style x:Key="ConnCard" TargetType="Border">
                    <Setter Property="CornerRadius" Value="16"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Margin" Value="12"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.04" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.04" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.5" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity" To="0.22" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- rounded, accent-coloured action button -->
                <Style x:Key="AccentButton" TargetType="Button">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Padding" Value="0 10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.74"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Border Background="#192428" Opacity="0.985"/>
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0 0 0 8">
                    <TextBlock Text="How do you want to connect your CarthaBot?" Foreground="White"
                               FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick a connection method to continue." Foreground="#9FB0B7"
                               FontSize="15" HorizontalAlignment="Center" Margin="0 6 0 0"/>
                </StackPanel>

                <!-- two cards -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="2" Margin="20">

                    <!-- USB -->
                    <Border Style="{StaticResource ConnCard}" Width="300" BorderBrush="#0060ac">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.22" Color="Black"/></Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#30404A" Offset="0"/>
                                <GradientStop Color="#28333A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Border Width="68" Height="68" CornerRadius="34" HorizontalAlignment="Center" Background="#1A0060AC">
                                    <TextBlock Text="🔌" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#0060ac" CornerRadius="9" Padding="8 3">
                                    <TextBlock Text="★ Start here" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 12 0 0">
                                <Ellipse Width="9" Height="9" Fill="#0060ac" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="USB cable" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Foreground="#C7D2D7" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0 12 0 0"
                                       Text="Plug the CarthaBot in with the USB-C cable — the app flashes it and connects. Most reliable, best for the first time."/>
                            <Button Grid.Row="3" Style="{StaticResource AccentButton}" Background="#0060ac" Margin="0 16 0 0"
                                    Content="Use USB" Command="{Binding ChooseConnectionCommand}" CommandParameter="Usb"/>
                        </Grid>
                    </Border>

                    <!-- WiFi -->
                    <Border Style="{StaticResource ConnCard}" Width="300" BorderBrush="#37D67A">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.22" Color="Black"/></Border.Effect>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#30404A" Offset="0"/>
                                <GradientStop Color="#28333A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="68" Height="68" CornerRadius="34" HorizontalAlignment="Center" Background="#1A37D67A">
                                <TextBlock Text="📶" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 12 0 0">
                                <Ellipse Width="9" Height="9" Fill="#37D67A" VerticalAlignment="Center" Margin="0 0 8 0"/>
                                <TextBlock Text="WiFi" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0 12 0 0">
                                <TextBlock Foreground="#C7D2D7" FontSize="13.5" TextWrapping="Wrap"
                                           Text="Make sure the robot is on your Wi-Fi and powered on, then press Use WiFi — the app finds it on your network automatically. No cable needed."/>
                                <TextBlock Text="Bridge address (IP : port)" Foreground="#9FB0B7" FontSize="12" Margin="0 12 0 4"/>
                                <TextBox Text="{Binding WifiEndpoint, UpdateSourceTrigger=PropertyChanged}" Background="#1C2A30" Foreground="White"
                                         CaretBrush="White" BorderBrush="#33454F" BorderThickness="1" Padding="8 6" FontFamily="Consolas" FontSize="13"/>
                                <Button Content="⚙  First time? Put the robot on your Wi-Fi" Command="{Binding OpenWifiSetupCommand}"
                                        Margin="0 10 0 0" Padding="6 7" Background="#22313A" Foreground="#9FE8C7" BorderThickness="0"
                                        Cursor="Hand" FontSize="12" FontWeight="DemiBold"/>
                            </StackPanel>
                            <Button Grid.Row="3" Style="{StaticResource AccentButton}" Background="#37D67A" Margin="0 16 0 0"
                                    Content="Use WiFi" Command="{Binding ChooseConnectionCommand}" CommandParameter="Wifi"/>
                        </Grid>
                    </Border>

                </UniformGrid>

                <controls:DMButton Grid.Row="2" Cursor="Hand" Command="{Binding CancelCommand}" Background="#2d383c"
                                   FontWeight="DemiBold" Foreground="White" FontSize="16" Padding="18 6" CornerRadius="5"
                                   HorizontalAlignment="Center" BorderThickness="1" Margin="5">
                    Cancel
                </controls:DMButton>
            </Grid>
        </Grid>

        <!-- ============ KID-FRIENDLY CONNECT (under-6 VPL) ============ -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowKidsConnect}" Value="true">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- playful background -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#16323B" Offset="0"/>
                        <GradientStop Color="#0E1A1F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- title -->
                <TextBlock Grid.Row="0" Text="{DynamicResource kidsConnTitle}" Foreground="White"
                           FontSize="40" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 4"/>

                <!-- bobbing robot -->
                <Viewbox Grid.Row="1" Width="180" Height="180" HorizontalAlignment="Center">
                    <TextBlock Text="🤖" FontFamily="Segoe UI Emoji" FontSize="120" HorizontalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="KidsBotBob"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="KidsBotBob" Storyboard.TargetProperty="Y"
                                                         From="-12" To="12" Duration="0:0:1">
                                            <DoubleAnimation.EasingFunction>
                                                <SineEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Viewbox>

                <!-- status pill -->
                <Border Grid.Row="2" Background="#22313A" CornerRadius="20" Padding="26 12"
                        HorizontalAlignment="Center" Margin="0 6 0 0">
                    <TextBlock Text="{Binding KidsConnectStatus}" Foreground="#9FE8C7" FontSize="20"
                               FontWeight="DemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>

                <!-- three big, wordless-ish steps -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 24 0 0">
                    <Border Background="#2d383c" CornerRadius="16" Padding="16 14" Margin="10" Width="180">
                        <StackPanel>
                            <TextBlock Text="🔌" FontFamily="Segoe UI Emoji" FontSize="44" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource kidsConnPlug}" Foreground="White" FontSize="16" FontWeight="DemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2d383c" CornerRadius="16" Padding="16 14" Margin="10" Width="180">
                        <StackPanel>
                            <TextBlock Text="🔘" FontFamily="Segoe UI Emoji" FontSize="44" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource kidsConnTurnOn}" Foreground="White" FontSize="16" FontWeight="DemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2d383c" CornerRadius="16" Padding="16 14" Margin="10" Width="180">
                        <StackPanel>
                            <TextBlock Text="✨" FontFamily="Segoe UI Emoji" FontSize="44" HorizontalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource kidsConnReadyStep}" Foreground="White" FontSize="16" FontWeight="DemiBold"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0 26 0 0">
                    <!-- Already flashed once? Connect the robot with no cable. -->
                    <TextBlock Text="Already set up? Connect with no cable:" Foreground="#7FB8A6" FontSize="15"
                               FontWeight="DemiBold" HorizontalAlignment="Center" Margin="0 0 0 12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <controls:DMButton Cursor="Hand" Command="{Binding KidsWifiCommand}" Background="#37D67A"
                                           FontWeight="Bold" Foreground="White" FontSize="17" Padding="26 10" CornerRadius="22"
                                           BorderThickness="0" Margin="8 0" Content="📶  Wi-Fi"/>
                    </StackPanel>
                    <controls:DMButton Cursor="Hand" Command="{Binding CancelCommand}" Background="#2d383c"
                                       FontWeight="Bold" Foreground="White" FontSize="18" Padding="26 10" CornerRadius="22"
                                       HorizontalAlignment="Center" BorderThickness="0" Margin="0 20 0 0"
                                       Content="{DynamicResource kidsConnBack}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ============ CONNECT CARTHABOT TO YOUR WI-FI (in-app provisioning) ============ -->
        <Grid Grid.ColumnSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowWifiSetup}" Value="true">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Background="#0E1A1F"/>
            <Border Width="470" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#16242B" CornerRadius="16" Padding="26">
                <StackPanel>
                    <TextBlock Text="📡 Connect CarthaBot to your Wi-Fi" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick (or type) your Wi-Fi, plug the robot in with the USB cable, and press Save. The robot joins your network and remembers it — then you code over carthabot.local, with no network switching." Foreground="#9FB0B7" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0 6 0 16"/>
                    <TextBlock Text="Pick your Wi-Fi network" Foreground="#9FB0B7" FontSize="12" Margin="0 0 0 4"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding ScannedNetworks}" SelectedItem="{Binding SelectedNetwork}"
                                  DisplayMemberPath="Ssid" FontSize="13" Padding="6 4" Height="32"/>
                        <Button Grid.Column="1" Content="🔄 Scan" Command="{Binding ScanWifiCommand}" Margin="8 0 0 0"
                                Background="#22313A" Foreground="#9FE8C7" BorderThickness="0" Padding="12 6" Cursor="Hand" FontSize="12" FontWeight="DemiBold"/>
                    </Grid>
                    <TextBlock Text="…or type the name" Foreground="#9FB0B7" FontSize="12" Margin="0 0 0 4"/>
                    <TextBox Text="{Binding WifiSsidInput, UpdateSourceTrigger=PropertyChanged}" Background="#1C2A30" Foreground="White" CaretBrush="White" BorderBrush="#33454F" BorderThickness="1" Padding="8 6" FontSize="13"/>
                    <TextBlock Text="Wi-Fi password" Foreground="#9FB0B7" FontSize="12" Margin="0 12 0 4"/>
                    <TextBox Text="{Binding WifiPassword, UpdateSourceTrigger=PropertyChanged}" Background="#1C2A30" Foreground="White" CaretBrush="White" BorderBrush="#33454F" BorderThickness="1" Padding="8 6" FontSize="13"/>
                    <TextBlock Text="Tip: the robot only joins 2.4 GHz Wi-Fi (not 5 GHz) — pick your 2.4 GHz network." Foreground="#9FB0B7" FontSize="11" TextWrapping="Wrap" Margin="0 6 0 0"/>
                    <Button Content="💾  Save to robot (USB cable)" Command="{Binding SaveWifiOverUsbCommand}" Background="#37D67A" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="10 11" Margin="0 16 0 0" Cursor="Hand" FontSize="14"/>
                    <TextBlock Margin="0 10 0 0" Foreground="#F2C94C" FontSize="12.5" FontWeight="DemiBold" HorizontalAlignment="Center" Text="⏳ Working… please wait">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="true">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Background="#22313A" CornerRadius="8" Padding="10" Margin="0 14 0 0">
                        <TextBlock Text="{Binding ProvisionStatus}" Foreground="#9FE8C7" FontSize="12.5" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 14 0 0">
                        <Button Content="Skip — it's already on Wi-Fi" Command="{Binding SkipWifiCommand}" Background="#22313A" Foreground="#9FE8C7" BorderThickness="0" Padding="12 8" Margin="0 0 8 0" Cursor="Hand"/>
                        <Button Content="Close" Command="{Binding CloseWifiSetupCommand}" Background="#2d383c" Foreground="White" BorderThickness="0" Padding="12 8" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
