<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Both CompanionApp and AdvancedProgramming reference this single assembly so the
         ITransport types (CarthaBotVPL.Services) are defined exactly once.
         TFM kept at windows10.x for compatibility with the referencing projects. -->
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
</Project>
