<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.x TFM matches CarthaBotTransport so the shared ITransport assembly
         (which uses WinRT Bluetooth LE for BleTransport) resolves here too. -->
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Data\PythonSource.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Data\PythonSource.py">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MahApps.Metro.IconPacks" Version="6.1.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Prism.Unity" Version="8.1.97" />
    <PackageReference Include="Quicker.AvalonEdit" Version="6.3.1" />
    <PackageReference Include="Scintilla.NET.Wpf" Version="1.0.11.5320" />
    <PackageReference Include="Syncfusion.Edit.WPF" Version="28.1.38" />
    <PackageReference Include="Syncfusion.SfInput.WPF" Version="28.1.38" />
    <PackageReference Include="Syncfusion.Shared.WPF" Version="28.1.38" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CarthaBotTransport\CarthaBotTransport.csproj" />
  </ItemGroup>
</Project>